#!/bin/bash
set -eu

# Full workstation setup for a fresh macOS machine.
# Usage: setup-mac <work|personal>

usage() {
  echo "Usage: $(basename "$0") <work|personal>" >&2
  exit 2
}

[ "$#" -eq 1 ] || usage
PROFILE=$1

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"

case "$PROFILE" in
  work | personal) ;;
  *) usage ;;
esac

# xcode command line tools
if ! xcode-select -p &>/dev/null; then
  xcode-select --install
  echo "Finish the Command Line Tools install, then re-run this script."
  exit 0
fi

# homebrew
if ! command -v brew &>/dev/null; then
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
# put brew on PATH for this session (Apple Silicon or Intel)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# packages needed on both work and personal machines
brew install --no-ask \
  antidote \
  autoconf \
  cloc \
  cmake \
  coreutils \
  gh \
  git \
  jq \
  neovim \
  pre-commit \
  stow \
  tldr \
  tree \
  uv \
  vim \
  watch \
  wget

brew install --no-ask --cask \
  chatgpt \
  codex \
  font-fira-code-nerd-font \
  ghostty \
  google-chrome \
  iterm2 \
  itsycal \
  jordanbaird-ice \
  monitorcontrol \
  rectangle \
  slack \
  spotify \
  sublime-text \
  visual-studio-code \
  zed

# dotfiles
if [ ! -d "$HOME/.dotfiles" ]; then
  git clone https://github.com/nunoh/dotfiles "$HOME/.dotfiles"
fi
"$DOTFILES/scripts/bootstrap"

# python
uv python install --default

# dock: clear default items
defaults write com.apple.dock persistent-apps -array
defaults write com.apple.dock persistent-others -array
killall Dock || true

# personal-only setup
if [ "$PROFILE" = personal ]; then
  brew install --no-ask \
    ffmpeg \
    htop \
    imagemagick \
    mas \
    sqlite \
    terminal-notifier

  brew install --no-ask --cask \
    appcleaner \
    audacity \
    calibre \
    firefox \
    flux-app \
    hammerspoon \
    obsidian \
    openinterminal-lite \
    pearcleaner \
    qlmarkdown \
    quicklook-video \
    surfshark \
    transmission \
    vlc

  # Mac App Store apps: forScore, iReal Pro, Xcode.
  # This needs an App Store sign-in, so don't abort the rest of the setup if it fails.
  mas install 363738376 409035833 497799835 ||
    echo "mas install failed — sign into the App Store, then retry the IDs above."

  if [ ! -d "$HOME/.nvm" ]; then
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/HEAD/install.sh | bash
  fi
fi

# work-only setup
if [ "$PROFILE" = work ]; then
  # Work currently needs only the common setup above.
  :
fi

# done
echo ""
echo "Setup complete ($PROFILE). Manual steps remaining:"
echo "  - Authenticate GitHub CLI: gh auth login"
echo "  - Set git identity: git config -f ~/.gitconfig.local user.name/user.email"
echo "  - Copy ~/.ssh, .zsh_history from old machine"
echo "  - Sign into Codex, ChatGPT, Chrome, and other installed apps"
if [ "$PROFILE" = personal ]; then
  echo "  - Restore macOS/app prefs: mackup restore (review osx/.mackup.cfg first)"
  echo "  - Install own builds not on brew: uSwitch, LaunchKnife"
  echo "  - Sign into Firefox / Chrome / VS Code sync"
fi
