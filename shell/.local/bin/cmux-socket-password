#!/usr/bin/env bash
# Print cmux's automation socket password, and put it back into cmux.json if
# cmux dropped it.
#
# cmux strips `automation.socketPassword` during a one-shot migration (keyed by
# `socketControlPasswordMigrationVersion` in its defaults), which locks every
# CLI caller out until the key returns. It has already happened twice. Keeping
# our own copy under ~/.local/state means any script can heal cmux.json instead
# of failing, and the password stays out of the dotfiles repo.
set -euo pipefail

STORE="${HOME}/.local/state/cmux/socket-password"
CONF="${HOME}/.config/cmux/cmux.json"
CONF_DIR="$(dirname "$CONF")"

extract() {
  [ -f "$1" ] || return 0
  /usr/bin/plutil -extract automation.socketPassword raw -o - "$1" 2>/dev/null || true
}

password=""
[ -f "$STORE" ] && password="$(cat "$STORE")"
[ -z "$password" ] && password="$(extract "$CONF")"

# Last resort on a machine that has neither: cmux writes a timestamped .bak
# before each migration, so the password we lost is still in the newest one.
if [ -z "$password" ]; then
  for bak in $(ls -t "$CONF_DIR"/*.bak "$CONF_DIR"/*.bak.* 2>/dev/null || true); do
    password="$(extract "$bak")"
    [ -n "$password" ] && break
  done
fi

if [ -z "$password" ]; then
  echo "cmux-socket-password: no password found." >&2
  echo "  Set one in cmux Settings > Automation, then run this again." >&2
  exit 1
fi

if [ "$(cat "$STORE" 2>/dev/null || true)" != "$password" ]; then
  mkdir -p "$(dirname "$STORE")"
  (umask 077; printf '%s\n' "$password" > "$STORE")
fi

if [ "$(extract "$CONF")" != "$password" ]; then
  python3 - "$CONF" "$password" <<'PY'
import json, sys

path, password = sys.argv[1], sys.argv[2]
with open(path) as handle:
    conf = json.load(handle)
conf.setdefault("automation", {})["socketPassword"] = password
with open(path, "w") as handle:
    json.dump(conf, handle, indent=2)
    handle.write("\n")
PY
  echo "cmux-socket-password: restored automation.socketPassword in cmux.json." >&2
  echo "  If the CLI still fails, press Cmd+Shift+, in cmux to reload." >&2
fi

printf '%s' "$password"
