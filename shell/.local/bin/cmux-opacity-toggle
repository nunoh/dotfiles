#!/usr/bin/env bash
# Toggle Ghostty background opacity in a local runtime override, then reload cmux.
# cmux renders the window background itself, so Ghostty's runtime
# `toggle_background_opacity` action does not update all of its chrome.
set -euo pipefail

CONF="${HOME}/.local/state/ghostty/runtime.conf"
TRANSPARENT="0.85"
OPAQUE="1.0"

mkdir -p "$(dirname "$CONF")"
current="$OPAQUE"
if [ -f "$CONF" ]; then
  # Stop at the first match; a `| head -1` here can SIGPIPE sed under pipefail.
  current="$(sed -n '/^background-opacity = /{s///p;q;}' "$CONF")"
fi

case "$current" in
  1|1.0|1.00) next="$TRANSPARENT" ;;
  *)          next="$OPAQUE" ;;
esac

printf 'background-opacity = %s\n' "$next" > "$CONF"

# cmux only accepts control-socket connections whose responsible process is cmux
# itself. Hammerspoon spawns us, so we are rejected unless we authenticate with
# the automation password, with `automation.socketControlMode` set to "password".
#
# cmux-socket-password keeps the password in ~/.local/state and writes it back
# into cmux.json whenever a cmux migration strips it, so this keeps working
# across updates.
password="$("${HOME}/.local/bin/cmux-socket-password" 2>/dev/null || true)"
if [ -n "$password" ]; then
  export CMUX_SOCKET_PASSWORD="$password"
fi

# Hammerspoon tasks have a minimal PATH, so fall back to the app-bundled CLI.
CMUX="$(command -v cmux 2>/dev/null || true)"
[ -z "$CMUX" ] && CMUX="/Applications/cmux.app/Contents/Resources/bin/cmux"
"$CMUX" reload-config >/dev/null
