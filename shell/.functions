function path() {
    echo $PATH | tr ":" "\n" | nl
}

if [[ "$OSTYPE" == "darwin"* ]]; then
  o() { open "$@" }
else
  o() { nohup nautilus "$@" >/dev/null 2>&1 &! }
fi

# External monitor controls over DDC/CI via ddcutil (Linux desktop only).
# No arg reads the current value; a number (0-100) sets it.
#   brightness        -> print current brightness   (VCP 0x10)
#   brightness 50     -> set brightness to 50
#   contrast 30       -> set contrast to 30          (VCP 0x12)
if command -v ddcutil >/dev/null 2>&1; then
  brightness() {
    if [[ -z "$1" ]]; then
      ddcutil getvcp 10 2>/dev/null | grep -oP 'current value =\s*\K[0-9]+'
    else
      ddcutil setvcp 10 "$1" 2>/dev/null && echo "brightness → $1"
    fi
  }
  contrast() {
    if [[ -z "$1" ]]; then
      ddcutil getvcp 12 2>/dev/null | grep -oP 'current value =\s*\K[0-9]+'
    else
      ddcutil setvcp 12 "$1" 2>/dev/null && echo "contrast → $1"
    fi
  }
fi

# tmux session per project directory. `tm` (no args) attaches to or creates a
# session named after the current dir. `tm name` overrides the name.
# Works inside tmux (switch-client) or outside it (attach).
tm() {
  command -v tmux >/dev/null 2>&1 || { echo "tmux not installed"; return 1; }
  local name="${1:-$(basename "$PWD")}"
  name="${name//./-}"; name="${name//:/-}"     # tmux forbids '.' and ':'
  if [ -n "$TMUX" ]; then
    tmux has-session -t "$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$PWD"
    tmux switch-client -t "$name"
  else
    tmux attach -t "$name" 2>/dev/null || tmux new -s "$name" -c "$PWD"
  fi
}

# Auto-attach on an interactive SSH login that lands inside a project, so a
# Termius profile per project drops straight into that project's session.
# Guards: SSH_CONNECTION so local shells are untouched; interactivity so
# scp/rsync/scripted ssh keep working; and $PWD != $HOME so a plain
# `ssh host` stays a plain shell instead of making a junk session.
if command -v tmux >/dev/null 2>&1 \
   && [ -z "$TMUX" ] && [ -n "$SSH_CONNECTION" ] && [[ $- == *i* ]] \
   && [[ "$PWD" != "$HOME" ]]; then
  tm
fi
