# Shared zsh config, sourced by the machine-local ~/.zshrc.
# Common to all machines — keep machine-specific settings in ~/.zshrc.

# Antidote — zsh plugin manager. https://github.com/mattmc3/antidote
# Plugins listed in ~/.zsh_plugins.txt.
source $HOME/.antidote/antidote.zsh

ZSH_THEME="${ZSH_THEME:-robbyrussell}"

# Login shells set up fnm in zprofile.shared. Non-login shells (a nested
# `zsh`) need their own setup, so `fnm use` does not change the parent shell.
if (( $+commands[fnm] )) && [[ -z $_fnm_shell ]]; then
  eval "$(fnm env --use-on-cd --shell zsh --version-file-strategy recursive --resolve-engines=false)"
  fnm use --silent-if-unchanged
fi

antidote load

for f in ~/.dotfiles/shell/.*; do
  [[ -f "$f" ]] && source "$f"
done

# don't share command history between shell sessions
setopt APPEND_HISTORY

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# Show user@host in prompt when over SSH. The theme redraws PROMPT during
# precmd, so keep this hook persistent.
if [[ -n "$SSH_CONNECTION" ]]; then
  autoload -U add-zsh-hook
  _ssh_prompt_prefix() {
    PROMPT="%(?:%{$fg_bold[green]%}%1{➜%} :%{$fg_bold[red]%}%1{➜%} ) %{$fg_bold[yellow]%}%n@%m%{$reset_color%} %{$fg[cyan]%}%c%{$reset_color%} \$(git_prompt_info)"
  }
  add-zsh-hook precmd _ssh_prompt_prefix
fi
