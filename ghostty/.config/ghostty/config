# Ghostty config — ported from iTerm2 basics.
# Lives at ~/.config/ghostty/config on macOS and Linux.

# ── Appearance ────────────────────────────────────────────────────────────────
font-family = "FiraCode Nerd Font Mono"
font-size = 14

cursor-style = block
cursor-style-blink = false

background-opacity = 0.80
window-padding-x = 4
window-padding-y = 4

# ── macOS only ────────────────────────────────────────────────────────────────
macos-option-as-alt = left
macos-titlebar-style = tabs
macos-non-native-fullscreen = visible-menu

# ── Shell / behavior ──────────────────────────────────────────────────────────
shell-integration = detect
shell-integration-features = no-cursor
copy-on-select = false
confirm-close-surface = false
mouse-hide-while-typing = true

# ── Keybindings ───────────────────────────────────────────────────────────────
# Notes for Linux: replace `cmd` with `ctrl+shift` (Ghostty's Linux convention).
# You can keep this single file and the `cmd` binds will simply no-op there.

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+]=next_tab
keybind = cmd+shift+[=previous_tab
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5
keybind = cmd+6=goto_tab:6
keybind = cmd+7=goto_tab:7
keybind = cmd+8=goto_tab:8
keybind = cmd+9=last_tab

# Splits — iTerm uses cmd+d / cmd+shift+d
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Pane navigation (vim-style, ctrl+h/j/k/l)
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+l=goto_split:right

# Pane resize (cmd+ctrl+h/j/k/l)
keybind = cmd+ctrl+h=resize_split:left,10
keybind = cmd+ctrl+j=resize_split:down,10
keybind = cmd+ctrl+k=resize_split:up,10
keybind = cmd+ctrl+l=resize_split:right,10

# Clear — cmd+r clears visible screen (preserves scrollback, like iTerm cmd+r);
# cmd+k wipes screen + scrollback (like iTerm cmd+k / "Clear Buffer").
keybind = cmd+r=text:\x0c
keybind = cmd+k=clear_screen

# Toggle between configured background-opacity and fully opaque.
keybind = cmd+u=toggle_background_opacity

# Send alt+enter on shift+enter so apps that expect alt+enter for "soft newline"
# (e.g. hermes-agent) get the right input. Overrides kitty-protocol encoding for this key.
keybind = shift+enter=text:\x1b\r

# Quick terminal — global hotkey to toggle a drop-down ghostty window from anywhere.
keybind = global:cmd+escape=toggle_quick_terminal

# Misc
keybind = shift+enter=text:\n
